  "platform_conventions": {
    "android": {
      "status_inset": "24dp",
      "bottom_inset": "48dp",
      "min_touch_target": "48dp",
      "system_font": "Roboto",
      "frame": "360x800dp",
      "primary_nav": "MD-NavigationBar (bottom)"
    },
    "ios": {
      "status_inset": "44-59pt",
      "bottom_inset": "34pt",
      "min_touch_target": "44pt",
      "system_font": "SF Pro",
      "frame": "393x852pt",
      "primary_nav": "MD-NavigationBar as bottom tab bar"
