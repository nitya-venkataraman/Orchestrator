# Harness run artifacts
harness/results/*.json
harness/results/latest-*.md
eval-result.json

# Python
__pycache__/
*.pyc

# Editors / OS
.DS_Store

# Claude Code per-user local settings
.claude/settings.local.json

# UX pipeline run state (repo root) — regenerated per run, never committed
/workspace/
/workspace.bak-*/

# UX pipeline artifacts — one folder per project, regenerated per run, never
# committed. Allowlist: only user-story backlogs (the UserStoryGenerator
# deliverable) are tracked, in any project folder. Project directories must be
# un-ignored first — git cannot re-include a file inside an excluded directory.
output/*
!output/.gitkeep
!output/*/
output/*/*
!output/*/user-stories-*
