# Harness run artifacts
harness/results/*.json
harness/results/latest-*.md
eval-result.json

# Python
__pycache__/
*.pyc

# Editors / OS
.DS_Store

# Claude Code per-user local settings
.claude/settings.local.json

# UX pipeline run state (repo root) — regenerated per run, never committed
/workspace/
/workspace.bak-*/

# UX pipeline stage artifacts — regenerated per run, never committed.
# Allowlist: only user-story backlogs (the UserStoryGenerator deliverable) are
# tracked, so future pipeline stages stay ignored without touching this file.
output/*
!output/.gitkeep
!output/user-stories-*
