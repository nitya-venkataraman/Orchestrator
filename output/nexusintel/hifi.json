  "design_system_gaps": [
    {
      "screen": "All screens",
      "need": "A list / table row for queue, timeline, extracted-term, add-back, exposure and structure rows",
      "reason": "The library publishes no list-row or data-grid component usable on canvas — the AG Grid pages are documentation frames and 'To-Do List using AG Grid' is a fixed task-list composite. Rows are auto-layout frames composed from KKR text styles, Badge, Button (Tertiary / Inline) and Separator, with every fill, gap and padding bound to KKR variables."
    },
    {
      "screen": "04 - Borrower Profile, 06 - Risk Review",
      "need": "A provenance line under each metric naming the clause or feed it came from",
      "reason": "KPI Card's only secondary text is the 'As Of' date chip, which prefixes 'As Of:' and truncates at card width. The source line is set in body_s / Text/tertiary beneath the card inside a 'Metric Tile' wrapper."
    },
    {
      "screen": "01 - Screening Queue / loading, 04 - Borrower Profile / loading, 06 - Risk Review / loading, 07 - Portfolio Watch / loading, 08 - Position Detail / loading",
      "need": "Skeleton rows and tiles held at final height so the page does not reflow when data lands",
      "reason": "No skeleton component exists. Loading uses Bar Loader plus placeholder '—' values in KPI Card; Bar Loader's copy ('Please wait / This might take a few minutes') is not exposed as a property, so it cannot name what is loading."
    },
    {
      "screen": "All '/ empty' frames",
      "need": "An empty-state pattern that names what will appear and offers the next action",
      "reason": "No empty-state component is published. The DS file has a WIP 'Empty State Banner' page, but it is not in the library. Empty states use Inline Notification (Info / Warning / Success) plus Button."
    },
    {
      "screen": "03 - Document Extraction",
      "need": "An extracted-term reconciliation row: extracted value, source excerpt, editable override, confidence, accept / correct in place",
      "reason": "No such control exists. Rendered as a composed row with a Badge for confidence (Success / Warning / Error, each with a text label). Accept / correct / override are not represented."
    },
    {
      "screen": "03 - Document Extraction, 08 - Position Detail",
      "need": "A source-excerpt popover: highlighted citing sentence, document / page / clause reference, deep link, plus 'resolving' and 'could not be located' states",
      "reason": "Tooltip carries a single label and Dialog is modal. Rendered as a static 'Source Passage' panel (surface/subtle, label_s caption, body_s quote) without its two failure states."
    },
    {
      "screen": "04 - Borrower Profile",
      "need": "A challenge flag that holds evidence and records an accept / dismiss decision",
      "reason": "Inline Notification is informational, with no actions or decision record. Rendered as a Warning Inline Notification; adjudication is not represented."
    },
    {
      "screen": "05 - Corporate Structure",
      "need": "A structure canvas with entity nodes, guarantee overlay and keyboard-navigable tree",
      "reason": "No tree or graph component exists. Rendered as the wireframe's indented outline equivalent, with Badge for 'Unrated offshore' (Warning) and 'Unverified' (Error)."
    },
    {
      "screen": "07 - Portfolio Watch, 08 - Position Detail",
      "need": "A covenant-headroom meter with a fixed threshold marker, signed distance, breached and 'no current data' states",
      "reason": "Meter exposes Label and Data text only. Its fill level is not settable, so every instance shows the component's default fill (including 'No current data'), and there is no threshold marker or unknown state. The text carries the meaning; the bar does not."
    },
    {
      "screen": "06 - Risk Review",
      "need": "A review thread (open / answered / resolved / blocking, with reply)",
      "reason": "No thread or accordion component exists. Threads are Inline Notifications (Error = blocking, Info = open), with no reply or resolve affordance."
    },
    {
      "screen": "02 - Precedent Search",
      "need": "A desk-attribution chip with own-desk / other-desk / restricted variants, and the relationship map from the page spec",
      "reason": "Badge has only status types; 'Other desk' uses Badge/Warning. The wireframe frame has no relationship map and the DS has no graph component, so the map is not built."
    }
  ],
  "blocking_gaps": []
}
